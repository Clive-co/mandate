# Copy to server/.env (loaded automatically by the server). Every value is optional in development.

# --- Database -------------------------------------------------------------------------------
# Real Postgres. If unset, the server runs on PGlite (Postgres in-process) stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# --- Signing --------------------------------------------------------------------------------
# ES256 private key (a JWK, as JSON on one line) used to sign verdicts. REQUIRED in production.
# In development one is generated into server/data/signing-key.json.
# Create one with:  npm run gen-key -w server
SIGNING_KEY_JWK=
# After rotating, keep the OLD public key(s) here so verdicts already issued still verify.
# A JSON array of public JWKs. They are published in /.well-known/jwks.json.
RETIRED_JWKS=
# The `iss` claim. Sellers must be configured with this exact value.
ISSUER=http://localhost:8787

# --- Chain ----------------------------------------------------------------------------------
# Base Sepolia RPC. The public endpoint is rate limited; use Alchemy/Infura/etc. if you hit limits.
RPC_URL=https://sepolia.base.org
# USDC on Base Sepolia (Circle): https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# --- Server ---------------------------------------------------------------------------------
PORT=8787
CORS_ORIGIN=http://localhost:5173

# --- Scripts --------------------------------------------------------------------------------
# `npm run send-usdc`: a funded Base Sepolia TESTNET wallet. Never a key that holds real funds.
SENDER_PRIVATE_KEY=
# `npm run seed`: a wallet you control (the vendor the demo agents pay) and, optionally, the wallet
# you will pay FROM (enables the sender check for research-bot).
SEED_RECIPIENT=
SEED_AGENT_WALLET=
