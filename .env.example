# Copy to server/.env (loaded automatically by the server)

# Key the server uses to sign decisions (EIP-712). This key never holds funds.
# Generate one with:  npm run gen-key -w server
SIGNER_PRIVATE_KEY=

# Base Sepolia RPC. The public endpoint is rate limited; use Alchemy/Infura/etc. if you hit limits.
RPC_URL=https://sepolia.base.org

# USDC on Base Sepolia (Circle): https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

PORT=8787
DB_PATH=./data/mandate.db
CORS_ORIGIN=http://localhost:5173

# Only for `npm run send-usdc` (a funded Base Sepolia TESTNET wallet; never a real-money key)
SENDER_PRIVATE_KEY=

# Optional for `npm run seed`: your own wallet, so you can send real transfers to it
SEED_RECIPIENT=
